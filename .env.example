# Workshop0 v0.2 — copy to .env and fill in. `.env` is gitignored; never commit it.

# --- Database ---
# SQLAlchemy URL. Default is SQLite in data/ (local dev only). Production (Cloud Run)
# uses PostgreSQL: postgresql+psycopg://user:pass@host:5432/db (postgres:// and
# postgresql:// are normalised automatically). On Cloud Run this comes from Secret Manager.
DATABASE_URL=sqlite:///data/workshop0.db
# PostgreSQL connection pool (ignored on SQLite). Budget: max-instances x (pool + overflow) <= ~15.
WORKSHOP0_DB_POOL_SIZE=3
WORKSHOP0_DB_MAX_OVERFLOW=2
# Tests only: a throwaway PostgreSQL database whose name ends in _test (the suite
# refuses anything else). See README "Run the tests".
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/workshop0_test

# --- Server ---
PORT=8001
# 1 (default) = the container entrypoint runs `alembic upgrade head` before serving
# (local docker compose). Cloud Run sets 0: migrations run only in the workshop0-migrate job.
WORKSHOP0_MIGRATE_ON_BOOT=1
# Absolute base URL for generated share links (set when running behind a proxy).
# Leave empty to derive from the request.
WORKSHOP0_BASE_URL=

# --- Logging ---
WORKSHOP0_LOG_LEVEL=INFO

# --- Facilitator access (REQUIRED) ---
# The instance access key entered on the Admin Home page. Choose any strong string (>=16 chars).
WORKSHOP0_ADMIN_KEY=

# --- AI help-desk (Phase 4; optional) ---
# Absent => the product runs fully air-gapped with zero errors and AI surfaces show a labelled off state.
OPENROUTER_API_KEY=
WORKSHOP0_AI_MODEL=anthropic/claude-sonnet-4-6
WORKSHOP0_AI_CONFIDENCE=0.75

# --- Trainer network sign-in (Phase 11; optional) ---
# Google OAuth web client. Both empty => sign-in disabled (labelled "not set up" state, zero errors).
WORKSHOP0_GOOGLE_CLIENT_ID=
WORKSHOP0_GOOGLE_CLIENT_SECRET=
# OIDC issuer for discovery. http:// is allowed ONLY for localhost/127.0.0.1 (the test issuer).
WORKSHOP0_OIDC_ISSUER=https://accounts.google.com
# REQUIRED when sign-in is enabled: signs the OIDC state cookie. Generate: openssl rand -hex 32
WORKSHOP0_SESSION_SECRET=
# Comma-separated admin allowlist (case-insensitive; verified Google emails only).
WORKSHOP0_ADMIN_EMAILS=

# --- CV storage (Phase 11) ---
# local (data/blobs/, default) or gcs (production).
WORKSHOP0_BLOB_BACKEND=local
# Required when WORKSHOP0_BLOB_BACKEND=gcs (production: ai-agent-boilerplate0-workshop0-cvs).
WORKSHOP0_GCS_BUCKET=

# --- Trainer network AI (Phase 11; Anthropic direct; optional) ---
# Absent => CV drafting is skipped and shortlists are "Ranked by rules"; zero errors.
ANTHROPIC_API_KEY=
# REQUIRED with the key: sent as header anthropic-workspace-id on EVERY request
# (the key is not workspace-scoped; without it Anthropic returns 400).
ANTHROPIC_WORKSPACE_ID=
# Anthropic model for CV extraction + shortlist ranking.
WORKSHOP0_AI_NETWORK_MODEL=claude-sonnet-5-5
# Anthropic model for cheap calls (client smoke tests only in Phases 11-13).
WORKSHOP0_AI_NETWORK_FAST_MODEL=claude-haiku-5-5

# --- Transactional email (Phase 12; optional) ---
# Any of host/user/password missing => outbox rows are recorded ("not sent"), zero errors.
# Gmail: smtp.gmail.com:587 + STARTTLS + a Google app password (never your account password).
WORKSHOP0_SMTP_HOST=
WORKSHOP0_SMTP_PORT=587
WORKSHOP0_SMTP_STARTTLS=true
WORKSHOP0_SMTP_USER=
WORKSHOP0_SMTP_PASSWORD=
# From address; defaults to WORKSHOP0_SMTP_USER when empty.
WORKSHOP0_SMTP_FROM=
# Rate limits per rolling hour, checked at drain time (excess => recorded, "rate_limited").
WORKSHOP0_EMAIL_RATE_PER_RECIPIENT=10
WORKSHOP0_EMAIL_RATE_GLOBAL=100
